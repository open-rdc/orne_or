<?xml version="1.0" ?>
<robot name="orne_or_cart" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PI" value="3.1415926535897931"/>
  <xacro:include filename="$(find icart_mini_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find icart_mini_description)/urdf/sensors/imu.urdf.xacro"/>
  <xacro:include filename="$(find orne_or_description)/urdf/cart/orne_or_cart.gazebo.xacro"/>
  <xacro:include filename="$(find orne_or_description)/urdf/cart/orne_or_cart.transmission.xacro"/>

  <!-- Base -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.3 0 0.2" rpy="0 0 0"/>
      <mass value="25.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="0.1" />
    </inertial>
    <visual>
        <geometry>
          <mesh filename="package://orne_or_description/meshes/bases/base_link.stl"/>
        </geometry>
        <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.090 0 0.1715" rpy="0 0 0"/>
      <geometry>
        <box size="0.400 0.404 0.202"/>
      </geometry>
    </collision>
  </link>

  <!-- Left Wheel -->

  <joint name="left_wheel_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.1525 0.075" rpy="${-PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100.0"  lower="-5000" upper="5000" />
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.030" radius="0.075"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.030" radius="0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>

  </link>

  <!-- Right Wheel -->

  <joint name="right_wheel_hinge" type="revolute">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.1525 0.075" rpy="${-PI/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100.0"  lower="-5000" upper="5000" />
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.030" radius="0.075"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.030" radius="0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>

  </link>

  <!-- Caster -->

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front_link"/>
    <origin xyz="-0.3 0 0.050" rpy="0 0 0"/>
  </joint>

  <link name="caster_front_link">
    <visual>
      <origin xyz="0 0.150 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.050"/>
      </geometry>
      <material name="red"/>
    </visual>
        <collision>
      <origin xyz="0 0.150 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.050"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 -0.150 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.050"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 -0.150 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.025" radius="0.050"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
    </inertial>
  </link>

  <!-- LiDAR -->
  <xacro:include filename="$(find icart_mini_description)/urdf/sensors/hokuyo.urdf.xacro"/>
  <xacro:sensor_hokuyo name="hokuyo" parent="base_link">
    <origin xyz="0.12 0 0.3" rpy="0 0 0"/>
  </xacro:sensor_hokuyo>

</robot>
